# Compatibility wrapper. The provider-neutral launcher defaults to Codex.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
echo "grok-phone is now agent-phone; starting the provider-neutral bridge." >&2
exec "$SCRIPT_DIR/agent-phone" "$@"
